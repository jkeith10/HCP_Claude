# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Anthropic API key — powers the assistant (Claude).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Housecall Pro API key (Pro / MAX plan required).
# Settings -> API in your Housecall Pro account. Stored ONLY as this env var.
HOUSECALL_API_KEY=

# Housecall Pro API base URL. Override only if directed to by HCP support.
HOUSECALL_API_BASE=https://api.housecallpro.com

# Optional shared password gating access to the app. STRONGLY recommended,
# since the assistant can create/update jobs and estimates in your real
# account. Leave blank to disable the gate (e.g. local-only testing).
APP_PASSWORD=

# Claude model id. Defaults to Opus 4.8 if unset.
ANTHROPIC_MODEL=claude-opus-4-8

# Port the server listens on.
PORT=3000
